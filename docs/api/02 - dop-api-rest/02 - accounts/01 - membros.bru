meta {
  name: membros da conta ativa
  type: http
  seq: 2
}

get {
  url: {{bffUrl}}/api/v1/accounts/current/members
  body: none
  auth: inherit
}

docs {
  Exige conta ativa (`@account_scoped`) E papel de gestão (`@require_role`).

  - sem `x-account-id` → **400**
  - com papel `developer` → **403**
  - com papel `owner`/`admin` → **200**
}
