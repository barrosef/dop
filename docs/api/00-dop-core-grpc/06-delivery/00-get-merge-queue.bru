meta {
  name: GetMergeQueue
  type: grpc
  seq: 1
}

grpc {
  url: {{coreGrpc}}
  method: /dop.v1.DeliveryService/GetMergeQueue
  body: grpc
  auth: none
}

metadata {
  x-actor-id: {{actorId}}
  x-account-id: {{accountId}}
  x-request-id: {{$guid}}
}

body:grpc {
  [
    {
      "repo_id": "{{repoId}}"
    }
  ]
}

docs {
  The queue is PER REPOSITORY (ADR-0008), with a deterministic order `(priority,
  seq)` — `seq` is unique per repository, assigned under a lock. Two entries never
  tie ambiguously.
}
