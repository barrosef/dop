meta {
  name: EnqueueMerge — no green, no entry
  type: grpc
  seq: 2
}

grpc {
  url: {{coreGrpc}}
  method: /dop.v1.DeliveryService/EnqueueMerge
  body: grpc
  auth: none
}

metadata {
  x-actor-id: {{actorId}}
  x-account-id: {{accountId}}
  x-request-id: {{$guid}}
}

body:grpc {
  [
    {
      "repo_id": "{{repoId}}",
