meta {
  name: emulador — criar usuário
  type: http
  seq: 2
}

post {
  url: {{authEmulator}}/identitytoolkit.googleapis.com/v1/accounts:signUp?key=fake-api-key
  body: json
  auth: none
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{userPassword}}",
    "returnSecureToken": true
  }
}

script:post-response {
  if (res.body.idToken) {
    bru.setEnvVar("idToken", res.body.idToken);
    console.log("idToken gravado no ambiente");
  }
}

docs {
  Cria um usuário no emulador do Firebase Auth e grava o `idToken` no ambiente.

  Rode esta requisição primeiro: as demais já saem autenticadas. Se o usuário já
  existir, use `emulador — entrar`.
}
