meta {
  name: Criar integração
  type: http
  seq: 1
}

post {
  url: {{bffUrl}}/api/v1/resources
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "kind": "integration",
    "name": "GitHub da org",
    "config": {
      "category": "git",
      "provider": "github"
    }
  }
}

docs {
  Cria SEM credencial — o segredo entra pela requisição seguinte.

  `category` é string minúscula: `git`, `task_manager` ou `agent`. Quem manda no
  vocabulário é o provedor, não a plataforma (ADR-0013).
}
