meta {
  name: healthz
  type: http
  seq: 1
}

get {
  url: {{bffUrl}}/healthz
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.status: eq ok
}

docs {
  A health probe. It is `@public` — the only endpoint that does not require a
  token, because Kubernetes' probe has no credential.
}
