meta {
  name: me
  type: http
  seq: 1
}

get {
  url: {{bffUrl}}/api/v1/me
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

docs {
  Who I am, in the active account.

  The `Principal` returned is NORMALIZED — Firebase claims do not reach here
  (ADR-0001). With no token: 401. With a token and no `x-account-id`: the account
  fields come back empty.
}
