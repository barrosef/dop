meta {
  name: SetCredential
  type: grpc
  seq: 2
}

grpc {
  url: {{coreGrpc}}
  method: /dop.v1.ResourceService/SetCredential
  body: grpc
  auth: none
}

body:grpc {
  [
    {
      "ctx": { "account": { "id": "{{accountId}}" }, "actor": { "kind": "KIND_USER", "id": "u-1" } },
      "resource_id": "res-github",
      "secret": "Z2hwX2V4ZW1wbG8tZGUtdG9rZW4="
    }
  ]
}

docs {
  O segredo vai para o `SecretStore` — no local, um Secret do Kubernetes (não
  existe emulador do GCP Secret Manager). A resposta traz só o `credential_ref`.

  Numa conta PJ, preferir credencial de ORGANIZAÇÃO (GitHub App): token pessoal
  morre quando a pessoa sai (ADR-0003).
}
